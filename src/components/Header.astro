---
import Logo from './Logo.astro'
import Nav from './Nav.astro'
import type { Locale } from '../lib/translations';

export interface Props {
  current?: string;
  lang?: Locale;
}

const { current = '', lang = 'id' } = Astro.props;
---

<style>
  header {
    display: flex;
    margin: 0 auto;
    max-width: 1400px;
    padding: 2em;
    width: 100%;
  }

  @media screen and (max-width: 520px) {
    header {
      padding: 2em 0;
    }
  }
</style>

<header>
  <Logo lang={lang} />
  <Nav current={current} lang={lang} />
</header>
