---
import { LOCALES, getLocalePath, pathWithoutLocale } from "../lib/locale-path";
import { t, type Locale } from "../lib/translations";

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = "" } = Astro.props;
const path = pathWithoutLocale(Astro.url.pathname);
const search = Astro.url.search;
const hash = Astro.url.hash;
---

<nav
  class:list={["lang-switcher", className]}
  aria-label={t("langSwitchLabel", locale)}
>
  {
    LOCALES.map((loc) => (
      <a
        href={getLocalePath(loc, path) + search + hash}
        lang={loc}
        hreflang={loc}
        aria-current={loc === locale ? "page" : undefined}
        class:list={[
          "lang-switcher__link",
          loc === locale && "lang-switcher__link--active",
        ]}
      >
        {t(loc === "id" ? "langId" : "langEn", locale)}
      </a>
    ))
  }
</nav>
