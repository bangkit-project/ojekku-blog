---
import { t, type Locale } from "../lib/translations";

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = "" } = Astro.props;
---

<nav
  class:list={["theme-switcher", className]}
  aria-label={t("themeSwitchLabel", locale)}
>
  <button
    type="button"
    class="theme-switcher__btn theme-switcher__btn--active"
    data-theme-set="dark"
    aria-label={t("themeDark", locale)}
    aria-pressed="true"
  >
    <svg
      class="theme-switcher__icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </button>
  <button
    type="button"
    class="theme-switcher__btn"
    data-theme-set="light"
    aria-label={t("themeLight", locale)}
    aria-pressed="false"
  >
    <svg
      class="theme-switcher__icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
      ></path>
    </svg>
  </button>
</nav>
