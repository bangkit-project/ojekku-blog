---
import FontSizeToggle from './FontSizeToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { t, type Locale } from '../lib/translations';

export interface Props {
  current?: string;
  lang?: Locale;
}

const { current = '', lang = 'id' } = Astro.props;
const localePrefix = `/${lang}`;
---

<style>
  nav {
    align-items: center;
    display: flex;
    flex: 1;
    font-family: var(--font-family-sans);
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.25em;
  }

  .nav-chrome {
    margin-left: 12px;
  }

  .nav-search-pill {
    display: inline-flex;
    padding: 0.2rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    flex-shrink: 0;
  }

  .nav-search {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.5rem;
    text-decoration: none;
    color: var(--color-muted);
    border-radius: 999px;
    background: transparent;
  }

  .nav-search:hover {
    color: var(--color-text);
  }

  .nav-search:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .nav-search.selected {
    color: var(--color-text);
    background: var(--color-accent-subtle);
  }

  .nav-search__icon {
    display: block;
    width: 1rem;
    height: 1rem;
  }
</style>

<nav>
  <div class="nav-chrome">
    <div class="nav-search-pill">
      <a
        class:list={['nav-search', current === 'search' && 'selected']}
        href={`${localePrefix}/search`}
        aria-label={t('searchLabel', lang)}
      >
        <svg
          class="nav-search__icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </a>
    </div>
    <ThemeToggle locale={lang} />
    <FontSizeToggle locale={lang} />
  </div>
</nav>
