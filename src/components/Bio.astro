---
import { t, type Locale } from '../lib/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<div>
  <p>
    <strong>Ojekku.com</strong> {t('bioLead', lang)}
  </p>
</div>

<style>
  div {
    margin-top: 2em;
  }

  p {
    font-size: 1.05rem;
    color: var(--text-secondary);
  }

  strong {
    color: var(--text-main);
  }
</style>
