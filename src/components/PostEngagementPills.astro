---
import type { Locale } from '../lib/translations';

interface Props {
  channelMessageId: number;
  lang: Locale;
  commentHref?: string;
  detailed?: boolean;
  telegramUrl?: string;
}

const { channelMessageId, lang, commentHref, detailed = false, telegramUrl } = Astro.props;
---

<p
  class="post-list-meta post-list-engagement"
  data-post-engagement
  data-channel-message-id={channelMessageId}
  data-lang={lang}
  data-loading="true"
  {...commentHref ? { 'data-comment-href': commentHref } : {}}
  {...detailed ? { 'data-detailed': 'true' } : {}}
  {...telegramUrl ? { 'data-telegram-url': telegramUrl } : {}}
>
  <span class="engagement-skeleton" aria-hidden="true">
    <span class="engagement-skeleton__pill" />
    <span class="engagement-skeleton__pill" />
  </span>
  <span class="sr-only">{lang === 'en' ? 'Loading engagement' : 'Memuat reaksi dan komentar'}</span>
</p>
