<script is:inline>
  (function () {
    var STORAGE_KEY = "ojekku-font-size";
    var MIN = 0;
    var MAX = 4;
    var DEFAULT = 1;

    function parseLevel(value) {
      if (value === "normal") return 1;
      if (value === "large") return 2;
      var parsed = parseInt(value, 10);
      if (!isNaN(parsed) && parsed >= MIN && parsed <= MAX) return parsed;
      return DEFAULT;
    }

    function resolveLevel() {
      return parseLevel(localStorage.getItem(STORAGE_KEY));
    }

    function currentLevel() {
      var fromDom = document.documentElement.dataset.fontSize;
      if (fromDom !== undefined) return parseLevel(fromDom);
      return DEFAULT;
    }

    function restoreFontSize(root) {
      var level = resolveLevel();
      root.dataset.fontSize = String(level);
    }

    function applyLevel(level) {
      var clamped = Math.min(MAX, Math.max(MIN, level));
      document.documentElement.dataset.fontSize = String(clamped);
      localStorage.setItem(STORAGE_KEY, String(clamped));
      syncFontSizeToggle();
    }

    function syncFontSizeToggle() {
      var level = currentLevel();
      document.querySelectorAll("[data-font-size-step]").forEach(function (btn) {
        var step = btn.getAttribute("data-font-size-step");
        if (step === "down") {
          btn.disabled = level <= MIN;
        } else if (step === "up") {
          btn.disabled = level >= MAX;
        }
      });
    }

    function restoreLive() {
      restoreFontSize(document.documentElement);
      syncFontSizeToggle();
    }

    function onFontSizeClick(e) {
      var btn = e.target.closest("[data-font-size-step]");
      if (!btn || btn.disabled) return;
      var step = btn.getAttribute("data-font-size-step");
      var level = currentLevel();
      if (step === "down") applyLevel(level - 1);
      else if (step === "up") applyLevel(level + 1);
    }

    if (!window.__ojekkuFontSizeInit) {
      window.__ojekkuFontSizeInit = true;
      restoreLive();
      document.addEventListener("click", onFontSizeClick);
      document.addEventListener("astro:before-swap", function (event) {
        restoreFontSize(event.newDocument.documentElement);
      });
      document.addEventListener("astro:page-load", restoreLive);
    }
  })();
</script>
