---
import { t, type Locale } from "../lib/translations";

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = "" } = Astro.props;
---

<nav
  class:list={["font-size-toggle", className]}
  aria-label={t("fontSizeSwitchLabel", locale)}
>
  <button
    type="button"
    class="font-size-toggle__btn"
    data-font-size-step="down"
    aria-label={t("fontSizeDecrease", locale)}
    disabled
  >
    <svg
      class="font-size-toggle__icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" x2="16.65" y1="21" y2="16.65"></line>
      <line x1="8" x2="14" y1="11" y2="11"></line>
    </svg>
  </button>
  <button
    type="button"
    class="font-size-toggle__btn"
    data-font-size-step="up"
    aria-label={t("fontSizeIncrease", locale)}
  >
    <svg
      class="font-size-toggle__icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" x2="16.65" y1="21" y2="16.65"></line>
      <line x1="11" x2="11" y1="8" y2="14"></line>
      <line x1="8" x2="14" y1="11" y2="11"></line>
    </svg>
  </button>
</nav>
