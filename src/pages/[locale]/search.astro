---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import type { Locale } from '../../lib/translations';
import { t, tPageOf } from '../../lib/translations';

const LOCALES: Locale[] = ['en', 'id'];

export async function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}

const { locale } = Astro.params as { locale: string };
if (!LOCALES.includes(locale as Locale)) return Astro.redirect('/id/');
const lang = locale as Locale;
const permalink = `${Astro.site?.href ?? ''}${lang}/search`;
---

<BaseLayout
  title={t('searchTitle', lang)}
  description={t('searchDescription', lang)}
  permalink={permalink}
  current="search"
  lang={lang}
>
  <div class="container">
    <h1>{t('searchTitle', lang)}</h1>
    <p class="search-hint">{t('searchHint', lang)}</p>

    <form class="search-form" action={`/${lang}/search`} method="get" role="search">
      <label class="sr-only" for="search-q">{t('searchLabel', lang)}</label>
      <input
        id="search-q"
        class="search-input"
        name="q"
        placeholder={t('searchPlaceholder', lang)}
        autocomplete="off"
        autofocus
      />
      <button type="submit" class="search-btn">{t('searchButton', lang)}</button>
    </form>

    <div id="search-status" class="search-status"></div>
    <ol id="search-results" class="search-results"></ol>
    <div id="search-pagination" class="hidden">
      <Pagination>
        <button slot="prev" type="button" id="search-prev" class="pagination-btn">
          <span class="sr-only">{t('previous', lang)}</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>
        <button
          type="button"
          id="page-picker"
          data-lang={lang}
          data-current="1"
          data-total="1"
          class="pagination-picker"
        >
          {tPageOf(1, 1, lang)}
        </button>
        <button slot="next" type="button" id="search-next" class="pagination-btn">
          <span class="sr-only">{t('next', lang)}</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M9 6l6 6-6 6" />
          </svg>
        </button>
      </Pagination>
    </div>
  </div>

  <script is:inline define:vars={{ lang, searchIndexUnavailable: t('searchIndexUnavailable', lang) }}>
    const PAGE_SIZE = 10;

    function setPageInUrl(page) {
      const url = new URL(window.location.href);
      if (page <= 1) url.searchParams.delete('page');
      else url.searchParams.set('page', String(page));
      window.history.pushState({}, '', url);
    }

    function escapeHtml(s) {
      return String(s)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    async function run() {
      const statusEl = document.getElementById('search-status');
      const resultsEl = document.getElementById('search-results');
      const inputEl = document.getElementById('search-q');
      const paginationEl = document.getElementById('search-pagination');
      const prevBtn = document.getElementById('search-prev');
      const nextBtn = document.getElementById('search-next');
      const pickerBtn = document.getElementById('page-picker');

      if (!resultsEl) return;

      const params = new URLSearchParams(window.location.search);
      const query = (params.get('q') || '').trim();
      const pageRaw = params.get('page') || '1';
      const currentPage = Math.max(1, parseInt(pageRaw, 10) || 1);
      if (inputEl) inputEl.value = query;

      resultsEl.innerHTML = '';
      if (paginationEl) paginationEl.classList.add('hidden');

      if (!query) {
        if (statusEl) {
          statusEl.textContent =
            lang === 'id' ? 'Ketik kata kunci untuk mulai mencari.' : 'Type a query to start searching.';
        }
        return;
      }

      if (statusEl) statusEl.textContent = lang === 'id' ? 'Mencari…' : 'Searching…';

      let pagefind;
      try {
        pagefind = await import('/pagefind/pagefind.js');
      } catch (e) {
        if (statusEl) statusEl.textContent = searchIndexUnavailable;
        return;
      }

      if (!pagefind || typeof pagefind.search !== 'function') {
        if (statusEl) statusEl.textContent = searchIndexUnavailable;
        return;
      }

      let res;
      try {
        res = await pagefind.search(query, { filters: { locale: lang } });
      } catch (e) {
        if (statusEl) statusEl.textContent = searchIndexUnavailable;
        return;
      }
      const count = res?.results?.length ?? 0;

      if (!count) {
        if (statusEl) statusEl.textContent = lang === 'id' ? 'Tidak ada hasil.' : 'No results.';
        return;
      }

      const totalPages = Math.max(1, Math.ceil(count / PAGE_SIZE));
      const page = Math.min(currentPage, totalPages);

      if (page !== currentPage) setPageInUrl(page);

      if (statusEl) {
        statusEl.textContent =
          lang === 'id'
            ? `${count} hasil — halaman ${page} dari ${totalPages}.`
            : `${count} results — page ${page} of ${totalPages}.`;
      }

      const start = (page - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;
      const items = await Promise.all(res.results.slice(start, end).map((r) => r.data()));
      for (const item of items) {
        const title = item.meta?.title || item.meta?.page_title || item.url;
        const description = item.meta?.description || '';
        const li = document.createElement('li');
        li.innerHTML = `
          <a class="post-list-link" href="${escapeHtml(item.url)}">
            <strong>${escapeHtml(title)}</strong>
          </a>
          ${description ? `<p>${escapeHtml(description)}</p>` : ''}
          ${item.excerpt ? `<p>${item.excerpt}</p>` : ''}
        `;
        resultsEl.appendChild(li);
      }

      if (!paginationEl || !prevBtn || !nextBtn || !pickerBtn) return;
      if (totalPages <= 1) return;

      paginationEl.classList.remove('hidden');
      pickerBtn.dataset.lang = lang;
      pickerBtn.dataset.current = String(page);
      pickerBtn.dataset.total = String(totalPages);
      pickerBtn.textContent = lang === 'id' ? `Halaman ${page} dari ${totalPages}` : `Page ${page} of ${totalPages}`;

      prevBtn.hidden = page <= 1;
      nextBtn.hidden = page >= totalPages;

      prevBtn.onclick = () => {
        const nextPage = Math.max(1, page - 1);
        setPageInUrl(nextPage);
        run();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      };

      nextBtn.onclick = () => {
        const nextPage = Math.min(totalPages, page + 1);
        setPageInUrl(nextPage);
        run();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      };

      pickerBtn.onclick = () => {
        const total = Number(pickerBtn.dataset.total || '1');
        const current = Number(pickerBtn.dataset.current || '1');
        const label = lang === 'id' ? `Ke halaman (1-${total})` : `Go to page (1-${total})`;
        const input = window.prompt(label, String(current));
        if (!input) return;
        const n = Number(input);
        if (!Number.isFinite(n) || n < 1 || n > total) return;
        setPageInUrl(n);
        run();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      };
    }

    if (!window.__ojekkuSearchInit) {
      window.__ojekkuSearchInit = true;
      window.addEventListener('popstate', () => run());
      document.addEventListener('astro:page-load', () => run());
      document.addEventListener('submit', (e) => {
        const form = e.target.closest?.('.search-form');
        if (!form) return;
        e.preventDefault();
        const input = form.querySelector('#search-q');
        const query = (input?.value || '').trim();
        const url = new URL(form.action || window.location.href, window.location.origin);
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        url.searchParams.delete('page');
        window.history.pushState({}, '', url);
        run();
      });
    }

    run();
  </script>
</BaseLayout>

<style>
  .search-hint {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1em;
  }

  .search-status {
    margin-bottom: 1em;
    color: var(--text-secondary);
    font-family: var(--font-family-sans);
    font-size: 0.9rem;
  }

  .hidden {
    display: none;
  }
</style>
