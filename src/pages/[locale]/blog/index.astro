---
import { getCollection } from 'astro:content';
import { parseBlogEntryId, type BlogData } from '../../../content.config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CoverImage from '../../../components/CoverImage.astro';
import Pagination from '../../../components/Pagination.astro';
import { getPageSlice, getTotalPages } from '../../../lib/pagination';
import { getReadingTimeMinutes, formatReadingTime } from '../../../lib/reading-time';
import { t, tBlogHeaderTitle, tBlogSiteTitle, tPageOf } from '../../../lib/translations';
import { getAuthor } from '../../../lib/authors';
import type { Locale } from '../../../lib/translations';

const LOCALES: Locale[] = ['en', 'id'];

export async function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}

const { locale } = Astro.params as { locale: string };
if (!LOCALES.includes(locale as Locale)) return Astro.redirect('/id/');
const lang = locale as Locale;

const allEntries = await getCollection('blog', ({ data }) => !data.draft);
const sorted = allEntries
  .filter((e) => e.id.endsWith(`--${lang}`))
  .sort((a, b) => (b.data as BlogData).publishDate.getTime() - (a.data as BlogData).publishDate.getTime());

const currentPage = 1;
const entries = getPageSlice(sorted, currentPage);
const totalPages = getTotalPages(sorted.length);
const dateLocale = lang === 'en' ? 'en-US' : 'id-ID';
const title = tBlogSiteTitle(lang);
const permalink = `${Astro.site?.href ?? ''}${lang}/blog`;
---

<BaseLayout title={title} description={title} permalink={permalink} current="blog" lang={lang}>
  <div class="container">
    <h1>{tBlogHeaderTitle(lang)}</h1>
    <ul class="post-list">
      {entries.map((entry) => {
        const parsed = parseBlogEntryId(entry.id);
        if (!parsed) return null;
        const { slug } = parsed;
        const data = entry.data as BlogData;
        const cover = data.coverImage;
        const author = getAuthor(data.authorId);
        return (
          <li id={`post-${slug}`} class="post-list-item">
            <a
              href={`/${lang}/blog/${slug}${currentPage > 1 ? `?from=${currentPage}` : ''}`}
              class="post-list-link"
            >
              <div class="post-list-row">
                <div>
                  <strong>{data.title}</strong>
                  <p>{data.description}</p>
                  {author && (
                    <div class="post-list-meta">
                      <img src={author.avatarUrl} alt={author.name} width="32" height="32" loading="lazy" />
                      <div>
                        <p><strong>{author.name}</strong></p>
                        <p>
                          <time datetime={data.publishDate.toISOString()}>
                            {data.publishDate.toLocaleDateString(dateLocale, {
                              year: 'numeric',
                              month: 'short',
                              day: 'numeric',
                            })}
                          </time>
                          {' · '}
                          <span>{formatReadingTime(getReadingTimeMinutes(entry.body ?? ''), lang)}</span>
                        </p>
                      </div>
                    </div>
                  )}
                </div>
                {cover && (
                  <div class="post-list-cover">
                    <CoverImage src={cover} alt={data.title} width={480} height={240} />
                  </div>
                )}
              </div>
            </a>
          </li>
        );
      })}
    </ul>
    <Pagination show={totalPages > 1}>
      <button
        type="button"
        id="page-picker"
        data-lang={lang}
        data-current={currentPage}
        data-total={totalPages}
        class="pagination-picker"
      >
        {tPageOf(currentPage, totalPages, lang)}
      </button>
      {currentPage < totalPages && (
        <a slot="next" href={`/${lang}/blog/page/${currentPage + 1}`} class="pagination-btn">
          <span class="sr-only">{t('next', lang)}</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M9 6l6 6-6 6" />
          </svg>
        </a>
      )}
    </Pagination>
  </div>
</BaseLayout>

<script>
  const picker = document.getElementById('page-picker') as HTMLButtonElement | null;
  if (picker) {
    picker.addEventListener('click', () => {
      const total = Number(picker.dataset.total || '1');
      const lang = (picker.dataset.lang || 'id') as 'en' | 'id';
      const current = Number(picker.dataset.current || '1');
      const label = lang === 'id' ? `Ke halaman (1-${total})` : `Go to page (1-${total})`;
      const input = window.prompt(label, String(current));
      if (!input) return;
      const n = Number(input);
      if (!Number.isFinite(n) || n < 1 || n > total) return;
      const target = n === 1 ? `/${lang}/blog` : `/${lang}/blog/page/${n}`;
      window.location.href = target;
    });
  }
</script>
