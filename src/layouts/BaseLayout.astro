---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OjekkuThemeScript from '../components/OjekkuThemeScript.astro';
import type { Locale } from '../lib/translations';
import '../styles/lang-switcher.css';
import '../styles/theme-toggle.css';

export interface Props {
  title: string;
  description: string;
  permalink?: string;
  current?: string;
  lang?: Locale;
}

const { title, description, permalink, current, lang = 'id' } = Astro.props;
const resolvedPermalink = permalink ?? Astro.site?.href ?? Astro.url.href;
---

<html lang={lang} data-theme="dark">
<head>
  <BaseHead title={title} description={description} permalink={resolvedPermalink} />
</head>
<body>
  <div class="layout">
    <Header current={current} lang={lang} />

    <main>
      <slot />
    </main>

    <Footer />
  </div>
  <OjekkuThemeScript />
</body>
</html>

<style>
  .layout {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    min-height: 100vh;
  }

  main {
    flex: 1;
    position: relative;
    margin: 0 auto;
    max-width: 1400px;
    padding: 1em 2em;
    box-sizing: border-box;
    width: 100%;
    display: flex;
    flex-direction: column;
  }
</style>
