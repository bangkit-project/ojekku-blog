---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OjekkuFontSizeScript from '../components/OjekkuFontSizeScript.astro';
import OjekkuThemeScript from '../components/OjekkuThemeScript.astro';
import type { Locale } from '../lib/translations';
import '../styles/font-size-toggle.css';
import '../styles/theme-toggle.css';

export interface Props {
  title: string;
  description: string;
  headerTitle?: string;
  permalink?: string;
  current?: string;
  lang?: Locale;
  pageKind?: 'article' | 'blog' | 'default';
}

const { title, description, headerTitle, permalink, current, lang = 'id', pageKind = 'default' } = Astro.props;
const resolvedHeaderTitle = headerTitle ?? title;
const resolvedPermalink = permalink ?? Astro.site?.href ?? Astro.url.href;
---

<html lang={lang} data-theme="dark" data-font-size="1">
<head>
  <BaseHead title={title} description={description} permalink={resolvedPermalink} />
</head>
<body>
  <div class:list={['layout', pageKind === 'article' && 'layout--article']}>
    <Header
      headerTitle={resolvedHeaderTitle}
      current={current}
      lang={lang}
      titleVariant={pageKind === 'article' || pageKind === 'blog' ? 'article' : 'default'}
      titleTag={pageKind === 'article' ? 'p' : 'h1'}
    />

    <main>
      <slot />
    </main>

    <Footer />
  </div>
  <OjekkuThemeScript />
  <OjekkuFontSizeScript />
</body>
</html>

<style>
  .layout {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    min-height: 100vh;
  }

  main {
    flex: 1;
    position: relative;
    margin: 0 auto;
    max-width: 1400px;
    padding: 1em 2em;
    box-sizing: border-box;
    width: 100%;
    display: flex;
    flex-direction: column;
  }
</style>
