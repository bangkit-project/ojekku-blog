# Ojekku Blog — environment variables (copy to `.env` for local dev)

# Blog API (Telegram comments/reactions mirror — browser read)
# Production API (engagement in browser)
PUBLIC_BLOG_API_BASE=https://blog-api.ojekku.com
# Local API (dotnet run --project 01_Api)
# PUBLIC_BLOG_API_BASE=http://localhost:5014
PUBLIC_BLOG_SITE_ID=ojekku-blog

# Telegram cross-post (local CLI only — not used by Netlify build)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@ojekku_channel
# TELEGRAM_SITE_URL=https://blog.ojekku.com
